---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import ProduktTipp from '../../components/ProduktTipp.astro';
import AutorBox from '../../components/AutorBox.astro';
import { THEMEN, abs, datum, iso, breadcrumbLd, faqLd, autor, ORG_ID, png } from '../../lib/site';
import { getEntry } from 'astro:content';
import Foto from '../../components/Foto.astro';
import { THEMA_FOTO } from '../../lib/fotos';

export async function getStaticPaths() {
  const alle = await getCollection('ratgeber');
  return alle.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content, headings } = await render(a);
const toc = headings.filter((h) => h.depth === 2);
const thema = await getEntry('themen', d.thema);
const weitere = (await getCollection('ratgeber')).filter((x) => x.id !== a.id && x.data.thema === d.thema).slice(0, 3);
const produkt = d.produkt ? await getEntry('produkte', d.produkt) : undefined;

const url = `/ratgeber/${a.id}/`;
const crumbs = [
  { name: 'Startseite', href: '/' },
  { name: 'Aufguss-Wissen', href: '/ratgeber/' },
  { name: THEMEN[d.thema], href: `/ratgeber/thema/${d.thema}/` },
  { name: d.titel, href: url },
];
const geaendert = d.aktualisiert ?? d.datum;
const artikelLd = {
  '@type': 'Article',
  '@id': abs(url) + '#artikel',
  headline: d.titel,
  description: d.seo.description ?? d.kurzantwort,
  datePublished: iso(d.datum),
  dateModified: iso(geaendert),
  inLanguage: 'de-AT',
  author: autor(),
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: abs(url),
  image: produkt ? abs(png(produkt.data.bild)) : abs('/images/og-almglut.png'),
  articleSection: THEMEN[d.thema],
  isPartOf: thema ? { '@type': 'CollectionPage', '@id': abs(`/ratgeber/thema/${d.thema}/`) } : undefined,
  about: d.seo.keyword ? { '@type': 'Thing', name: d.seo.keyword } : undefined,
};
const howtoLd = d.howto
  ? {
      '@type': 'HowTo',
      name: d.howto.name,
      ...(d.howto.dauer ? { totalTime: d.howto.dauer } : {}),
      step: d.howto.schritte.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })),
    }
  : null;
---
<Base title={d.seo.title ?? d.titel} description={d.seo.description ?? d.kurzantwort} ogType="article" ueberFoto noindex={d.seo.noindex} canonical={d.seo.canonical}
  ogImage={d.seo.ogImage ?? (produkt ? png(produkt.data.bild) : undefined)}
  schema={[artikelLd, howtoLd, breadcrumbLd(crumbs), faqLd(d.faq)]}>
  <Fragment slot="head">
    <meta property="article:published_time" content={iso(d.datum)} />
    <meta property="article:modified_time" content={iso(geaendert)} />
    <meta property="article:section" content={THEMEN[d.thema]} />
  </Fragment>
  <header class="a-kopf foto">
    <Foto k={THEMA_FOTO[d.thema]} prio />
    <div class="wrap">
      <a class="chip" href={`/ratgeber/thema/${d.thema}/`}>{THEMEN[d.thema]}</a>
      <h1>{d.titel}</h1>
      <p class="meta">Von <a href="/ueber-uns/">Julian Schindelegger</a> · Aktualisiert am <time datetime={iso(geaendert)}>{datum(geaendert)}</time> · {d.lesezeit} Min. Lesezeit</p>
    </div>
  </header>
  <Breadcrumbs items={crumbs} />
  <article class="wrap artikel">
    <div class="grid">
      <div>
        <p class="kurzantwort"><strong>Kurz gesagt</strong>{d.kurzantwort}</p>
        {toc.length > 2 && (
          <nav class="toc" aria-label="Inhaltsverzeichnis">
            <p>Inhalt</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="prosa"><Content /></div>
        <ProduktTipp slug={d.produkt} />
        <div class="faq-w"><Faq faq={d.faq} /></div>
        <AutorBox />
      </div>
    </div>
  </article>

  {weitere.length > 0 && (
    <section class="sektion sektion--nebel">
      <div class="wrap">
        <h2>Mehr zu {THEMEN[d.thema]}</h2>
        <ul class="raster raster--3 liste">
          {weitere.map((w) => <li class="karte"><a href={`/ratgeber/${w.id}/`}><strong>{w.data.titel}</strong><span>{w.data.lesezeit} Min.</span></a></li>)}
        </ul>
        {thema && <p style="margin-top:24px"><a href={`/ratgeber/thema/${d.thema}/`}>Alles zum Thema: {thema.data.titel} →</a></p>}
      </div>
    </section>
  )}
</Base>
<style>
  .artikel { padding-block: 24px clamp(56px, 8vw, 96px); }
  .a-kopf { min-height: 58vh; display: flex; align-items: flex-end; }
  .a-kopf .wrap { padding-block: 140px 56px; }
  .a-kopf h1 { font-size: clamp(2.1rem, 5vw, 3.8rem); max-width: 20ch; margin: 18px 0 14px; }
  .a-kopf .chip { text-decoration: none; background: rgb(255 255 255 / 92%); }
  .a-kopf .meta { color: rgb(255 255 255 / 85%); }
  .a-kopf .meta a { color: #fff; }
  .kopf .chip { text-decoration: none; margin-bottom: 18px; }
  .kopf h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); }
  .meta { font-size: 0.9rem; color: var(--grau); }
  .toc { max-width: var(--lesebreite); border: 1px solid var(--linie); border-radius: var(--r); padding: 18px 22px; margin-bottom: 2em; font-size: 0.95rem; }
  .toc p { font-weight: 700; color: var(--graphit); margin: 0 0 8px; }
  .toc ol { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; }
  .faq-w { max-width: var(--lesebreite); margin-top: 48px; }
  .liste { list-style: none; padding: 0; margin: 0; }
  .liste a { display: grid; gap: 8px; padding: 22px; text-decoration: none; height: 100%; }
  .liste strong { font: 500 1.15rem/1.3 var(--titel); color: var(--graphit); }
  .liste span { font-size: 0.85rem; color: var(--grau); }
</style>
