---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProduktKarte from '../components/ProduktKarte.astro';
import Faq from '../components/Faq.astro';
import { S, THEMEN, faqLd } from '../lib/site';

const produkte = (await getCollection('produkte')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const duefte = produkte.filter((p) => p.data.typ === 'duft');
const almbox = produkte.find((p) => p.id === 'almbox-geschenkset')!;
const artikel = (await getCollection('ratgeber')).sort((a, b) => +b.data.datum - +a.data.datum).slice(0, 3);
const themen = (await getCollection('themen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const faq = [
  { q: 'Was ist ALMGLUT?', a: 'ALMGLUT ist eine österreichische Marke für Saunaaufgüsse. Wir machen vier alpine Düfte (Zirbe, Latschenkiefer, Heublume, Bergminze) mit naturreinen ätherischen Ölen, abgefüllt in Österreich, und teilen unser Wissen rund um den Aufguss kostenlos im Ratgeber.' },
  { q: 'Was kostet ein Saunaaufguss von ALMGLUT?', a: '100 ml kosten 14,90 € und reichen für rund 40 Aufgüsse. Das Probierset mit allen vier Düften à 15 ml kostet 14,90 €, die Almbox mit allen vier Düften à 100 ml 49,90 €.' },
  { q: 'Wohin liefert ALMGLUT?', a: `Nach Österreich und Deutschland, Lieferzeit ${S.lieferzeit}. Ab ${S.versandkostenfrei_ab} € ist der Versand kostenlos.` },
  { q: 'Für welche Sauna sind die Aufgüsse geeignet?', a: 'Für die klassische finnische Sauna und die Biosauna, egal ob Heimsauna, Fasssauna oder Gartensauna.' },
];
---
<Base title="ALMGLUT – Saunaaufguss aus Österreich | Zirbe, Latsche, Heublume"
  description="ALMGLUT: alpine Saunaaufgüsse aus Österreich mit naturreinen ätherischen Ölen. Zirbe, Latschenkiefer, Heublume, Bergminze. Plus kostenloses Aufguss-Wissen."
  schema={[faqLd(faq)]}>

  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <p class="augenbraue">Saunaaufguss aus Österreich</p>
        <h1>Die Alm in <em>deiner Sauna.</em></h1>
        <p class="lead">Alpine Saunaaufgüsse mit naturreinen ätherischen Ölen: Zirbe, Latschenkiefer, Heublume und Bergminze. Abgefüllt in Österreich, gemacht für deine Heimsauna.</p>
        <div class="cta">
          <a href="/saunaaufguss/" class="btn btn--glut">Düfte entdecken</a>
          <a href="/duft-finder/" class="btn btn--linie">Welcher Duft passt zu mir?</a>
        </div>
      </div>
      <div class="hero-bild">
        <svg class="dampf" viewBox="0 0 200 160" aria-hidden="true">
          <path d="M60 150 C40 110 90 95 70 55 C58 30 80 15 76 0" />
          <path d="M100 150 C80 105 130 90 108 48 C96 25 116 12 112 0" />
          <path d="M140 150 C122 112 168 98 148 60 C138 38 156 22 152 4" />
        </svg>
        <img src="/images/produkte/zirbe.svg" alt="ALMGLUT No. 1 Zirbe Saunaaufguss in der Braunglasflasche" width="800" height="800" fetchpriority="high" />
      </div>
    </div>
    <svg class="berge" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 120 L0 80 L180 30 L320 70 L520 10 L700 75 L860 40 L1040 90 L1240 25 L1440 70 L1440 120 Z" />
    </svg>
  </section>

  <section class="vertrauen" aria-label="Unsere Versprechen">
    <ul class="wrap">
      <li><strong>Abgefüllt in Österreich</strong><span>Zirbe und Latsche aus den Alpen</span></li>
      <li><strong>Naturreine Öle</strong><span>ätherische Öle, keine Billig-Parfüms</span></li>
      <li><strong>Rund 40 Aufgüsse</strong><span>pro 100-ml-Flasche</span></li>
      <li><strong>Versandkostenfrei</strong><span>ab {S.versandkostenfrei_ab} € nach AT und DE</span></li>
    </ul>
  </section>

  <section class="sektion">
    <div class="wrap">
      <div class="sek-kopf">
        <div>
          <p class="augenbraue">Die Kollektion</p>
          <h2>Vier Düfte. Ein Saunaabend.</h2>
        </div>
        <a href="/saunaaufguss/" class="btn btn--linie">Alle Produkte</a>
      </div>
      <div class="raster raster--4">{duefte.map((p) => <ProduktKarte p={p} />)}</div>
    </div>
  </section>

  <section class="sektion sektion--dunkel ritual">
    <div class="wrap">
      <p class="augenbraue">Das ALMGLUT-Ritual</p>
      <h2>Frisch beginnen, warm enden.</h2>
      <p class="lead">Ein guter Saunaabend hat einen Rhythmus. Unsere Düfte folgen ihm, vom kühlen ersten Gang bis zum ruhigen letzten.</p>
      <ol class="schritte">
        <li><span class="nr">1. Gang</span><h3>Bergminze oder Latsche</h3><p>Kühl und klar. Der Duft öffnet, die Luft wirkt frischer, obwohl es heiß ist.</p></li>
        <li><span class="nr">2. Gang</span><h3>Heublume</h3><p>Warm und weich wie eine Almwiese im Juli. Jetzt wird es gemütlich.</p></li>
        <li><span class="nr">3. Gang</span><h3>Zirbe</h3><p>Holzig und ruhig. Der Duft für den letzten Aufguss und einen langen Abend.</p></li>
      </ol>
      <a href="/ratgeber/saunaaufguss-selber-machen/" class="btn btn--linie">So machst du den perfekten Aufguss</a>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap zwei">
      <div class="box-bild"><img src={almbox.data.bild} alt="ALMGLUT Almbox Geschenkset mit vier Saunaaufgüssen" width="800" height="800" loading="lazy" /></div>
      <div>
        <p class="augenbraue">Das Geschenk für Saunafans</p>
        <h2>Die Almbox</h2>
        <p class="lead">Alle vier Düfte à 100 ml in einer tannengrünen Box mit Holzwolle. Rund 160 Aufgüsse für 49,90 € statt 59,60 € einzeln.</p>
        <a href="/saunaaufguss/almbox-geschenkset/" class="btn btn--tanne">Zur Almbox</a>
      </div>
    </div>
  </section>

  <section class="sektion sektion--hell">
    <div class="wrap">
      <div class="sek-kopf">
        <div>
          <p class="augenbraue">Aufguss-Wissen</p>
          <h2>Alles rund um den Saunaaufguss</h2>
        </div>
        <a href="/ratgeber/" class="btn btn--linie">Zum Ratgeber</a>
      </div>
      <ul class="themen">
        {themen.map((t) => (
          <li><a href={`/ratgeber/thema/${t.id}/`}><strong>{t.data.navTitel}</strong><span>{t.data.kurzantwort.split('. ')[0]}.</span></a></li>
        ))}
      </ul>
      <div class="raster raster--3 artikel">
        {artikel.map((a) => (
          <a class="karte" href={`/ratgeber/${a.id}/`}>
            <span class="chip">{THEMEN[a.data.thema]}</span>
            <strong>{a.data.titel}</strong>
            <span class="meta">{a.data.lesezeit} Min. Lesezeit</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap werkzeuge">
      <a href="/aufguss-rechner/" class="werkzeug karte">
        <span class="augenbraue">Werkzeug</span>
        <h3>Aufguss-Rechner</h3>
        <p>Saunagröße eingeben und sofort sehen, wie viel Wasser und wie viel Aufguss du brauchst.</p>
        <span class="pfeil">Jetzt berechnen →</span>
      </a>
      <a href="/duft-finder/" class="werkzeug karte">
        <span class="augenbraue">Werkzeug</span>
        <h3>Duft-Finder</h3>
        <p>Vier kurze Fragen, eine klare Empfehlung: Welcher Saunaduft passt zu dir?</p>
        <span class="pfeil">Duft finden →</span>
      </a>
    </div>
  </section>

  <section class="sektion sektion--hell">
    <div class="wrap zwei gruender">
      <div>
        <p class="augenbraue">Wer hinter ALMGLUT steht</p>
        <h2>Gemacht von einem, der selbst gern sauniert.</h2>
        <p>Servus, ich bin {S.inhaber}. Ich wollte Saunaaufgüsse, die nach den Alpen riechen und nicht nach Duftbaum. Also habe ich mit einem Familienbetrieb in den Alpen vier Düfte entwickelt, die ich selbst in meiner Sauna verwende. [PLATZHALTER persönliche Geschichte]</p>
        <a href="/ueber-uns/">Mehr über ALMGLUT</a>
      </div>
      <div class="zitat"><p>„Ein Aufguss soll riechen wie ein Abend auf der Alm. Nicht mehr, nicht weniger.“</p><span>{S.inhaber}, Gründer</span></div>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap" style="max-width:820px"><Faq faq={faq} /></div>
  </section>
</Base>

<style>
  .hero { background: var(--tanne); color: var(--kalk); position: relative; overflow: hidden; }
  .hero-in { display: grid; gap: 24px; padding-block: clamp(48px, 8vw, 96px) clamp(80px, 10vw, 120px); align-items: center; }
  @media (min-width: 900px) { .hero-in { grid-template-columns: 1.15fr 0.85fr; } }
  .hero h1 { color: var(--kalk); font-size: clamp(2.6rem, 6.6vw, 5rem); }
  .hero h1 em { font-style: italic; color: var(--zirbe); }
  .hero .lead { color: #c9d3cc; }
  .hero .augenbraue { color: var(--zirbe); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero .btn--linie { color: var(--kalk); }
  .hero .btn--linie:hover { background: var(--kalk); color: var(--tanne); }
  .hero-bild { position: relative; max-width: 460px; justify-self: center; width: 100%; }
  .hero-bild img { border-radius: 50%; background: var(--kalk); box-shadow: 0 30px 80px rgb(0 0 0 / 30%); }
  .dampf { position: absolute; top: -22%; left: 30%; width: 40%; z-index: 2; fill: none; stroke: rgb(243 239 232 / 35%); stroke-width: 2; stroke-linecap: round; }
  .dampf path { stroke-dasharray: 220; animation: dampf 6s ease-in-out infinite; }
  .dampf path:nth-child(2) { animation-delay: 1.5s; }
  .dampf path:nth-child(3) { animation-delay: 3s; }
  @keyframes dampf { 0% { stroke-dashoffset: 220; opacity: 0; } 30% { opacity: 1; } 100% { stroke-dashoffset: -220; opacity: 0; } }
  .berge { position: absolute; bottom: -1px; left: 0; width: 100%; height: 70px; fill: var(--kalk); }

  .vertrauen ul { list-style: none; margin-block: 0; padding: 28px 0; display: grid; gap: 18px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .vertrauen ul { grid-template-columns: repeat(4, 1fr); } }
  .vertrauen li { display: grid; gap: 2px; padding-left: 16px; border-left: 2px solid var(--glut); }
  .vertrauen strong { color: var(--tanne); font-size: 0.98rem; }
  .vertrauen span { font-size: 0.85rem; color: var(--stein); }

  .sek-kopf { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 32px; }
  .sek-kopf h2 { margin: 0; }

  .ritual .schritte { list-style: none; padding: 0; margin: 40px 0; display: grid; gap: 1px; background: var(--tanne-3); border: 1px solid var(--tanne-3); border-radius: var(--r); overflow: hidden; }
  @media (min-width: 820px) { .ritual .schritte { grid-template-columns: repeat(3, 1fr); } }
  .schritte li { background: var(--tanne); padding: 30px 28px; }
  .schritte .nr { font: 600 0.8rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--glut); }
  .schritte h3 { margin: 14px 0 8px; }
  .schritte p { color: #c9d3cc; margin: 0; }

  .zwei { display: grid; gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (min-width: 860px) { .zwei { grid-template-columns: 1fr 1fr; } }
  .box-bild img { border-radius: var(--r); }

  .themen { list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 12px; }
  @media (min-width: 860px) { .themen { grid-template-columns: repeat(5, 1fr); } }
  .themen a { display: grid; gap: 6px; padding: 18px; border: 1px solid var(--linie); border-radius: var(--r); text-decoration: none; height: 100%; background: var(--kalk); }
  .themen a:hover { border-color: var(--tanne); }
  .themen strong { font: 500 1.08rem/1.25 var(--serif); color: var(--tanne); }
  .themen span { font-size: 0.85rem; color: var(--stein); line-height: 1.45; }
  .artikel a { display: grid; gap: 12px; padding: 24px; text-decoration: none; align-content: start; }
  .artikel strong { font: 500 1.2rem/1.3 var(--serif); color: var(--tanne); }
  .artikel .chip { justify-self: start; }
  .meta { font-size: 0.85rem; color: var(--stein); }

  .werkzeuge { display: grid; gap: 20px; }
  @media (min-width: 760px) { .werkzeuge { grid-template-columns: 1fr 1fr; } }
  .werkzeug { padding: clamp(24px, 4vw, 40px); text-decoration: none; color: var(--granit); display: grid; gap: 4px; transition: border-color 0.2s, box-shadow 0.2s; }
  .werkzeug:hover { border-color: var(--tanne); box-shadow: var(--schatten); }
  .pfeil { font-weight: 700; color: var(--glut-dunkel); margin-top: 8px; }

  .zitat { background: var(--tanne); color: var(--kalk); border-radius: var(--r); padding: clamp(28px, 4vw, 48px); }
  .zitat p { font: italic 400 clamp(1.4rem, 2.6vw, 2rem)/1.3 var(--serif); }
  .zitat span { color: var(--zirbe); font-size: 0.9rem; }
</style>
