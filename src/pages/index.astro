---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProduktKarte from '../components/ProduktKarte.astro';
import Faq from '../components/Faq.astro';
import Foto from '../components/Foto.astro';
import { S, THEMEN, faqLd } from '../lib/site';
import { THEMA_FOTO } from '../lib/fotos';

const produkte = (await getCollection('produkte')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const duefte = produkte.filter((p) => p.data.typ === 'duft');
const almbox = produkte.find((p) => p.id === 'almbox-geschenkset')!;
const artikel = (await getCollection('ratgeber')).sort((a, b) => +b.data.datum - +a.data.datum).slice(0, 3);
const themen = (await getCollection('themen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const faq = [
  { q: 'Was ist ALMGLUT?', a: 'ALMGLUT ist eine österreichische Marke für Saunaaufgüsse. Wir machen vier alpine Düfte (Zirbe, Latschenkiefer, Heublume, Bergminze) mit naturreinen ätherischen Ölen, abgefüllt in Österreich, und teilen unser Wissen rund um den Aufguss kostenlos im Ratgeber.' },
  { q: 'Was kostet ein Saunaaufguss von ALMGLUT?', a: '100 ml kosten 14,90 € und reichen für rund 40 Aufgüsse. Das Probierset mit allen vier Düften à 15 ml kostet 14,90 €, die Almbox mit allen vier Düften à 100 ml 49,90 €.' },
  { q: 'Wohin liefert ALMGLUT?', a: `Nach Österreich und Deutschland, Lieferzeit ${S.lieferzeit}. Ab ${S.versandkostenfrei_ab} € ist der Versand kostenlos.` },
  { q: 'Für welche Sauna sind die Aufgüsse geeignet?', a: 'Für die klassische finnische Sauna und die Biosauna, egal ob Heimsauna, Fasssauna oder Gartensauna.' },
];
---
<Base title="ALMGLUT – Saunaaufguss aus Österreich | Zirbe, Latsche, Heublume"
  description="ALMGLUT: alpine Saunaaufgüsse aus Österreich mit naturreinen ätherischen Ölen. Zirbe, Latschenkiefer, Heublume, Bergminze. Plus kostenloses Aufguss-Wissen."
  schema={[faqLd(faq)]} ueberFoto preload="/images/stock/hero-sonnenaufgang.webp">

  <section class="hero foto">
    <Foto k="hero-sonnenaufgang" prio />
    <div class="wrap hero-in">
      <p class="herkunft">47° N · Aufguss aus den Alpen</p>
      <h1>Die Alm in<br />deiner Sauna.</h1>
      <p class="lead">Saunaaufgüsse mit naturreinem Zirbenöl, Latschenkiefer und Bergkräutern. Abgefüllt in Österreich, gemacht für deine Heimsauna.</p>
      <div class="cta">
        <a href="/saunaaufguss/" class="btn btn--hell">Düfte entdecken</a>
        <a href="/duft-finder/" class="btn btn--glas">Welcher Duft passt zu mir?</a>
      </div>
    </div>
    <a href="#kollektion" class="scroll" aria-label="Weiter nach unten"><span></span></a>
  </section>

  <section class="sektion mitte" id="kollektion">
    <div class="wrap">
      <p class="augenbraue">Die Kollektion</p>
      <h2>Vier Düfte. <span class="glut-text">Ein Ritual.</span></h2>
      <p class="lead">Von kühl und klar bis warm und holzig. Je 100 ml für rund 40 Aufgüsse, nummeriert wie die Gänge eines Saunaabends.</p>
      <div class="raster raster--4 produkte rein">{duefte.map((p) => <ProduktKarte p={p} />)}</div>
      <p style="margin-top:40px"><a href="/saunaaufguss/" class="link-pfeil">Alle Produkte ansehen</a></p>
    </div>
  </section>

  <section class="moment foto">
    <Foto k="saunasteine-dampf" />
    <div class="wrap moment-in rein">
      <p class="augenbraue">Der Moment</p>
      <h2>Wenn der Aufguss zischt,<br />steht die Welt still.</h2>
      <p class="lead">Die Steine glühen, der Dampf steigt, und für ein paar Minuten riecht die ganze Sauna nach Zirbenwald. Genau dafür machen wir ALMGLUT.</p>
    </div>
  </section>

  <section class="sektion sektion--nebel">
    <div class="wrap">
      <div class="kopf-mitte mitte">
        <p class="augenbraue">Das ALMGLUT-Ritual</p>
        <h2>Frisch beginnen.<br />Warm enden.</h2>
      </div>
      <ol class="ritual">
        <li class="rein">
          <div class="r-bild"><Foto k="aufguss-kelle" sizes="(min-width: 900px) 33vw, 100vw" /></div>
          <span class="r-nr">1. Gang</span>
          <h3>Bergminze oder Latsche</h3>
          <p>Kühl und klar. Die Luft wirkt frischer, obwohl es 85 Grad hat.</p>
        </li>
        <li class="rein">
          <div class="r-bild"><Foto k="sauna-paar" sizes="(min-width: 900px) 33vw, 100vw" /></div>
          <span class="r-nr">2. Gang</span>
          <h3>Heublume</h3>
          <p>Warm und weich wie eine Almwiese im Juli. Jetzt wird es gemütlich.</p>
        </li>
        <li class="rein">
          <div class="r-bild"><Foto k="sauna-entspannung" sizes="(min-width: 900px) 33vw, 100vw" /></div>
          <span class="r-nr">3. Gang</span>
          <h3>Zirbe</h3>
          <p>Holzig und ruhig. Der Duft für den letzten Aufguss und einen langen Abend.</p>
        </li>
      </ol>
      <p class="mitte" style="margin-top:48px"><a href="/ratgeber/saunaaufguss-selber-machen/" class="link-pfeil">So machst du den perfekten Aufguss</a></p>
    </div>
  </section>

  <section class="herkunft-sek">
    <div class="h-bild"><Foto k="almhuette-schnee" sizes="(min-width: 900px) 50vw, 100vw" /></div>
    <div class="h-txt rein">
      <p class="augenbraue">Herkunft</p>
      <h2>Aus den Alpen.<br />Nicht aus dem Labor.</h2>
      <p class="lead">Unsere Zirbe wächst auf bis zu 2.300 Metern, die Latsche dort, wo der Wald aufhört. Destilliert und abgefüllt wird in Österreich, bei einem Familienbetrieb, der seit Jahrzehnten mit Bergpflanzen arbeitet.</p>
      <ul class="fakten">
        <li><strong>100 %</strong><span>naturreine ätherische Öle</span></li>
        <li><strong>4</strong><span>Düfte statt 50</span></li>
        <li><strong>~40</strong><span>Aufgüsse pro Flasche</span></li>
      </ul>
      <a href="/ueber-uns/" class="link-pfeil">Unsere Geschichte</a>
    </div>
  </section>

  <section class="sektion sektion--dunkel almbox">
    <div class="wrap zwei">
      <div class="rein">
        <p class="augenbraue">Das Geschenk für Saunafans</p>
        <h2>Die Almbox.</h2>
        <p class="lead">Alle vier Düfte à 100 ml in einer graphitfarbenen Box. Rund 160 Aufgüsse für 49,90 € statt 59,60 € einzeln.</p>
        <div class="cta">
          <a href="/saunaaufguss/almbox-geschenkset/" class="btn btn--glut">Zur Almbox</a>
          <a href="/ratgeber/saunaaufguss-geschenkideen/" class="btn btn--glas">Geschenkideen</a>
        </div>
      </div>
      <div class="box-bild rein"><img src={almbox.data.bild} alt="ALMGLUT Almbox Geschenkset mit vier Saunaaufgüssen" width="1200" height="1200" loading="lazy" /></div>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap">
      <div class="kopf-mitte mitte">
        <p class="augenbraue">Aufguss-Wissen</p>
        <h2>Alles, was du über<br />den Aufguss wissen willst.</h2>
        <p class="lead">Anleitungen, Dosierung, Düfte und Tipps für die Heimsauna. Ehrlich erklärt und kostenlos.</p>
      </div>
      <ul class="themen">
        {themen.map((t) => (
          <li class="rein">
            <a href={`/ratgeber/thema/${t.id}/`}>
              <Foto k={THEMA_FOTO[t.id]} sizes="(min-width: 900px) 20vw, 50vw" dekor />
              <span>{t.data.navTitel}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="raster raster--3 artikel">
        {artikel.map((a) => (
          <a class="art rein" href={`/ratgeber/${a.id}/`}>
            <span class="chip">{THEMEN[a.data.thema]}</span>
            <strong>{a.data.titel}</strong>
            <span class="meta">{a.data.lesezeit} Min. Lesezeit</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sektion sektion--nebel">
    <div class="wrap werkzeuge">
      <a href="/aufguss-rechner/" class="werkzeug rein">
        <span class="augenbraue">Werkzeug</span>
        <h3>Aufguss-Rechner</h3>
        <p>Saunagröße eingeben und sofort sehen, wie viel Wasser und wie viel Aufguss du brauchst.</p>
        <span class="link-pfeil">Jetzt berechnen</span>
      </a>
      <a href="/duft-finder/" class="werkzeug rein">
        <span class="augenbraue">Werkzeug</span>
        <h3>Duft-Finder</h3>
        <p>Vier kurze Fragen, eine klare Empfehlung: Welcher Saunaduft passt zu dir?</p>
        <span class="link-pfeil">Duft finden</span>
      </a>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap" style="max-width:820px"><Faq faq={faq} /></div>
  </section>

  <section class="schluss foto">
    <Foto k="huette-schnee-nacht" />
    <div class="wrap mitte rein">
      <p class="herkunft">47° N · Aufguss aus den Alpen</p>
      <h2>Bald in deiner Sauna.</h2>
      <p class="lead">Trag dich ein und sichere dir zum Start 10 % auf deine erste Bestellung.</p>
      <form name="warteliste-start" method="POST" data-netlify="true" netlify-honeypot="bot" action="/danke/" class="wl">
        <input type="hidden" name="form-name" value="warteliste-start" />
        <p class="visuell-versteckt"><label>Nicht ausfüllen <input name="bot" /></label></p>
        <label for="wl-start" class="visuell-versteckt">E-Mail-Adresse</label>
        <input id="wl-start" type="email" name="email" required placeholder="deine@mail.at" autocomplete="email" />
        <button type="submit" class="btn btn--glut">Auf die Warteliste</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .hero { min-height: 100svh; display: flex; align-items: flex-end; }
  .hero::after { background: linear-gradient(180deg, rgb(0 0 0 / 35%) 0%, rgb(0 0 0 / 5%) 35%, rgb(0 0 0 / 60%) 100%); }
  .hero-in { padding-block: 160px clamp(80px, 12vh, 140px); }
  .hero h1 { font-size: clamp(3rem, 9vw, 7.5rem); line-height: 0.95; letter-spacing: -0.045em; margin-bottom: 24px; }
  .hero .herkunft { color: rgb(255 255 255 / 85%); margin-bottom: 22px; }
  .hero .lead { max-width: 34ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .scroll { position: absolute; left: 50%; bottom: 28px; width: 26px; height: 42px; border: 1.5px solid rgb(255 255 255 / 70%); border-radius: 14px; transform: translateX(-50%); }
  .scroll span { position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; border-radius: 2px; background: #fff; transform: translateX(-50%); animation: scroll 2s infinite; }
  @keyframes scroll { 0% { opacity: 0; transform: translate(-50%, 0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, 14px); } }
  @media (max-width: 700px) { .scroll { display: none; } }

  .produkte { margin-top: 56px; text-align: left; }

  .moment { min-height: 88vh; display: flex; align-items: center; }
  .moment::after { background: linear-gradient(90deg, rgb(0 0 0 / 70%) 0%, rgb(0 0 0 / 20%) 65%); }
  .moment-in { padding-block: 120px; }
  .moment .lead { max-width: 38ch; }

  .kopf-mitte { margin-bottom: 56px; }
  .ritual { list-style: none; padding: 0; margin: 0; display: grid; gap: 24px; }
  @media (min-width: 900px) { .ritual { grid-template-columns: repeat(3, 1fr); } }
  .ritual li { background: #fff; border-radius: var(--r); overflow: hidden; padding-bottom: 28px; }
  .r-bild { aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: 24px; }
  .r-bild :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .r-nr { display: block; padding: 0 28px; font: 600 0.75rem/1 var(--text); letter-spacing: 0.2em; text-transform: uppercase; color: var(--glut-dunkel); }
  .ritual h3 { padding: 0 28px; margin: 12px 0 8px; }
  .ritual p { padding: 0 28px; margin: 0; color: var(--grau); }

  .herkunft-sek { display: grid; background: var(--leinen); }
  @media (min-width: 900px) { .herkunft-sek { grid-template-columns: 1fr 1fr; min-height: 720px; } }
  .h-bild { min-height: 420px; position: relative; }
  .h-bild :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .h-txt { padding: clamp(56px, 8vw, 110px) clamp(24px, 6vw, 88px); align-self: center; }
  .fakten { list-style: none; padding: 0; margin: 36px 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .fakten li { display: grid; gap: 4px; }
  .fakten strong { font: 600 clamp(1.8rem, 3vw, 2.6rem)/1 var(--titel); letter-spacing: -0.03em; }
  .fakten span { font-size: 0.85rem; color: var(--grau); }

  .zwei { display: grid; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (min-width: 860px) { .zwei { grid-template-columns: 1fr 1fr; } }
  .almbox h2 { color: #fff; }
  .box-bild img { border-radius: var(--r); }

  .themen { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 860px) { .themen { grid-template-columns: repeat(5, 1fr); } }
  .themen a { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: var(--r-m); overflow: hidden; text-decoration: none; color: #fff; }
  .themen a :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .themen a:hover :global(img) { transform: scale(1.05); }
  .themen a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgb(0 0 0 / 65%)); }
  .themen a span { position: absolute; left: 18px; right: 18px; bottom: 16px; z-index: 1; font: 600 1.15rem/1.2 var(--titel); letter-spacing: -0.01em; }
  .art { display: grid; gap: 12px; padding: 28px; border-radius: var(--r); background: var(--nebel); text-decoration: none; color: var(--graphit); align-content: start; transition: background 0.2s; }
  .art:hover { background: #ececef; color: var(--graphit); }
  .art strong { font: 600 1.3rem/1.25 var(--titel); letter-spacing: -0.02em; }
  .art .chip { justify-self: start; background: #fff; }
  .meta { font-size: 0.85rem; color: var(--grau); }

  .werkzeuge { display: grid; gap: 20px; }
  @media (min-width: 760px) { .werkzeuge { grid-template-columns: 1fr 1fr; } }
  .werkzeug { background: #fff; border-radius: var(--r); padding: clamp(28px, 4vw, 48px); text-decoration: none; color: var(--graphit); display: grid; gap: 6px; transition: transform 0.3s, box-shadow 0.3s; }
  .werkzeug:hover { transform: translateY(-3px); box-shadow: var(--schatten); color: var(--graphit); }
  .werkzeug h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0; }
  .werkzeug p { color: var(--grau); margin: 6px 0 10px; }

  .schluss { min-height: 80vh; display: flex; align-items: center; }
  .schluss::after { background: rgb(0 0 0 / 45%); }
  .schluss .wrap { padding-block: 120px; }
  .schluss .herkunft { color: rgb(255 255 255 / 85%); margin-bottom: 20px; }
  .wl { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 32px; }
  .wl input { flex: 0 1 320px; min-height: 50px; padding: 0 20px; border-radius: 999px; border: 0; }
</style>
