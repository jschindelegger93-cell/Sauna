---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../lib/site';
export async function getStaticPaths() {
  return (await getCollection('seiten')).map((s) => ({ params: { seite: s.id }, props: { s } }));
}
const { s } = Astro.props;
const { Content } = await render(s);
const crumbs = [{ name: 'Startseite', href: '/' }, { name: s.data.titel, href: `/${s.id}/` }];
---
<Base title={s.data.seo.title ?? s.data.titel} description={s.data.seo.description ?? `${s.data.titel} von ALMGLUT`} noindex={s.data.seo.noindex} schema={[breadcrumbLd(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <article class="schmal" style="padding-block:24px 96px">
    <h1>{s.data.titel}</h1>
    <div class="prosa"><Content /></div>
  </article>
</Base>
