---
import Base from '../layouts/Base.astro';
---
<Base title="Danke!" description="Danke für deine Nachricht." noindex>
  <section class="schmal" style="padding-block:96px;text-align:center">
    <p class="augenbraue">Angekommen</p>
    <h1>Danke, wir melden uns!</h1>
    <p class="lead" style="margin-inline:auto">Bis dahin: Lies dich ins Aufguss-Wissen ein oder berechne die richtige Menge für deine Sauna.</p>
    <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px">
      <a class="btn btn--glut" href="/ratgeber/">Zum Aufguss-Wissen</a>
      <a class="btn btn--dunkel" href="/aufguss-rechner/">Aufguss-Rechner</a>
    </p>
  </section>
</Base>
