---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { abs, breadcrumbLd, faqLd, ORG_ID } from '../lib/site';
const crumbs = [{ name: 'Startseite', href: '/' }, { name: 'Aufguss-Rechner', href: '/aufguss-rechner/' }];
const faq = [
  { q: 'Wie viel Wasser pro Aufguss in der Sauna?', a: 'Als Faustregel höchstens 20–30 ml Wasser pro Kubikmeter Saunaraum und Aufguss. Eine Sauna mit 7 m³ verträgt also etwa 140–210 ml pro Aufguss.' },
  { q: 'Wie berechne ich das Volumen meiner Sauna?', a: 'Länge × Breite × Höhe der Innenkabine in Metern. Beispiel: 2,0 × 1,8 × 2,0 m = 7,2 m³.' },
  { q: 'Wie viel Konzentrat kommt ins Aufgusswasser?', a: 'Bei ALMGLUT 3–5 ml pro Liter, bei Minze 2–4 ml. Andere Hersteller geben oft 5–15 ml an, die Angabe auf der Flasche hat Vorrang.' },
];
const appLd = {
  '@type': 'WebApplication',
  name: 'Aufguss-Rechner',
  url: abs('/aufguss-rechner/'),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Alle',
  inLanguage: 'de-AT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: { '@id': ORG_ID },
  description: 'Berechnet für jede Saunagröße die richtige Wassermenge pro Aufguss, die Anzahl der Kellen und die Menge Aufgusskonzentrat.',
};
---
<Base title="Aufguss-Rechner: Wie viel Wasser und Konzentrat pro Aufguss?"
  description="Kostenloser Aufguss-Rechner: Saunagröße eingeben und sofort sehen, wie viel Wasser, wie viele Kellen und wie viel Konzentrat du pro Aufguss brauchst."
  schema={[appLd, breadcrumbLd(crumbs), faqLd(faq)]}>
  <Breadcrumbs items={crumbs} />
  <section class="wrap rechner-seite">
    <header>
      <p class="augenbraue">Werkzeug</p>
      <h1>Aufguss-Rechner</h1>
      <p class="kurzantwort"><strong>Kurz gesagt</strong>Pro Aufguss höchstens <b>20–30 ml Wasser pro Kubikmeter</b> Saunaraum. Ins Aufgusswasser kommen bei ALMGLUT <b>3–5 ml Konzentrat pro Liter</b>. Gib unten deine Saunagröße ein, der Rechner erledigt den Rest.</p>
    </header>

    <form class="rechner karte" id="rechner" onsubmit="return false">
      <fieldset>
        <legend>Deine Sauna (Innenmaße)</legend>
        <div class="reihe">
          <div class="feld"><label for="l">Länge (m)</label><input id="l" type="number" inputmode="decimal" step="0.1" min="0.8" max="6" value="2.0" /></div>
          <div class="feld"><label for="b">Breite (m)</label><input id="b" type="number" inputmode="decimal" step="0.1" min="0.8" max="6" value="1.8" /></div>
          <div class="feld"><label for="h">Höhe (m)</label><input id="h" type="number" inputmode="decimal" step="0.1" min="1.6" max="3" value="2.0" /></div>
        </div>
      </fieldset>
      <fieldset>
        <legend>Aufguss</legend>
        <div class="reihe">
          <div class="feld">
            <label for="duft">Duft</label>
            <select id="duft">
              <option value="4">Zirbe, Latsche, Heublume (3–5 ml/l)</option>
              <option value="3">Bergminze, Minze, Eukalyptus (2–4 ml/l)</option>
            </select>
          </div>
          <div class="feld">
            <label for="int">Intensität</label>
            <select id="int">
              <option value="0.8">Sanft</option>
              <option value="1" selected>Normal</option>
              <option value="1.25">Kräftig</option>
            </select>
          </div>
          <div class="feld"><label for="anz">Aufgüsse pro Saunaabend</label><input id="anz" type="number" min="1" max="12" value="4" /></div>
        </div>
      </fieldset>

      <output class="ergebnis" for="l b h duft int anz" aria-live="polite">
        <div><span>Saunavolumen</span><strong id="r-vol">7,2 m³</strong></div>
        <div><span>Wasser pro Aufguss</span><strong id="r-wasser">145–215 ml</strong></div>
        <div><span>Kellen (à 80 ml)</span><strong id="r-kellen">2–3</strong></div>
        <div><span>Aufgusswasser pro Abend</span><strong id="r-abend">0,8 l</strong></div>
        <div><span>Konzentrat pro Abend</span><strong id="r-konz">3,2 ml</strong></div>
        <div><span>100-ml-Flasche reicht für</span><strong id="r-flasche">ca. 31 Abende</strong></div>
      </output>
    </form>

    <div class="prosa">
      <h2>So rechnet der Aufguss-Rechner</h2>
      <ol>
        <li><strong>Volumen:</strong> Länge × Breite × Höhe = Kubikmeter.</li>
        <li><strong>Wasser pro Aufguss:</strong> 20–30 ml pro Kubikmeter. Mehr Wasser macht die Luft drückend und belastet den Kreislauf.</li>
        <li><strong>Kellen:</strong> Eine übliche Saunakelle fasst etwa 80 ml.</li>
        <li><strong>Konzentrat:</strong> 4 ml pro Liter (Minze 3 ml), angepasst an die gewünschte Intensität.</li>
      </ol>
      <h2>Richtwerte nach Saunagröße</h2>
      <table>
        <thead><tr><th>Sauna</th><th>Volumen</th><th>Wasser pro Aufguss</th><th>Kellen</th></tr></thead>
        <tbody>
          <tr><td>Klein, 1–2 Personen</td><td>4–5 m³</td><td>80–150 ml</td><td>1–2</td></tr>
          <tr><td>Mittel, 2–4 Personen</td><td>6–8 m³</td><td>120–240 ml</td><td>2–3</td></tr>
          <tr><td>Groß, 4–6 Personen</td><td>9–12 m³</td><td>180–360 ml</td><td>3–4</td></tr>
        </tbody>
      </table>
      <p>Die komplette Anleitung findest du unter <a href="/ratgeber/saunaaufguss-selber-machen/">Saunaaufguss selber machen</a>, alles zur Dosierung unter <a href="/ratgeber/wie-viel-aufguss-pro-liter/">Wie viel Aufguss pro Liter?</a></p>
      <p class="mini">Die Werte sind Richtwerte für gesunde Erwachsene. Bei Herz-Kreislauf-Problemen vor dem Saunieren ärztlich abklären.</p>
    </div>
    <div style="max-width:820px;margin-top:56px"><Faq faq={faq} /></div>
  </section>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const fmt = (n: number, d = 1) => n.toLocaleString('de-AT', { maximumFractionDigits: d, minimumFractionDigits: 0 });
  const rund = (n: number) => Math.round(n / 5) * 5;
  function rechne() {
    const vol = Math.max(0.5, +$('l').value) * Math.max(0.5, +$('b').value) * Math.max(1, +$('h').value);
    const min = rund(vol * 20), max = rund(vol * 30);
    const kMin = Math.max(1, Math.round(min / 80)), kMax = Math.max(kMin, Math.round(max / 80));
    const anz = Math.min(12, Math.max(1, +$('anz').value || 1));
    const abendL = ((min + max) / 2) * anz / 1000;
    const konz = abendL * +$('duft').value * +$('int').value;
    $('r-vol').textContent = fmt(vol) + ' m³';
    $('r-wasser').textContent = `${min}–${max} ml`;
    $('r-kellen').textContent = kMin === kMax ? `${kMin}` : `${kMin}–${kMax}`;
    $('r-abend').textContent = fmt(Math.max(0.1, abendL)) + ' l';
    $('r-konz').textContent = fmt(konz) + ' ml';
    $('r-flasche').textContent = `ca. ${Math.max(1, Math.floor(100 / Math.max(konz, 0.5)))} Abende`;
  }
  document.getElementById('rechner')?.addEventListener('input', rechne);
  rechne();
</script>

<style>
  .rechner-seite { padding-block: 24px clamp(56px, 8vw, 96px); }
  .rechner { padding: clamp(20px, 4vw, 36px); margin-bottom: 56px; max-width: 980px; display: grid; gap: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font: 500 1.25rem/1.2 var(--titel); color: var(--graphit); margin-bottom: 14px; }
  .reihe { display: grid; gap: 14px; }
  @media (min-width: 640px) { .reihe { grid-template-columns: repeat(3, 1fr); } }
  .ergebnis { display: grid; gap: 1px; background: var(--graphit-3); border-radius: var(--r); overflow: hidden; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 760px) { .ergebnis { grid-template-columns: repeat(3, 1fr); } }
  .ergebnis div { background: var(--graphit); color: var(--nebel); padding: 18px 20px; display: grid; gap: 6px; }
  .ergebnis span { font-size: 0.8rem; color: #b8c6bd; }
  .ergebnis strong { font: 500 clamp(1.25rem, 2.6vw, 1.7rem)/1.1 var(--titel); color: var(--nebel); }
  .ergebnis div:nth-child(2) strong { color: #f0a372; }
  .mini { font-size: 0.85rem; color: var(--grau); }
</style>
