---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht." noindex>
  <section class="schmal" style="padding-block:96px;text-align:center">
    <p class="augenbraue">404</p>
    <h1>Hier ist nur Nebel.</h1>
    <p class="lead" style="margin-inline:auto">Die Seite gibt es nicht (mehr). Vielleicht findest du hier, was du suchst:</p>
    <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px">
      <a class="btn btn--glut" href="/saunaaufguss/">Saunaaufgüsse</a>
      <a class="btn btn--dunkel" href="/ratgeber/">Aufguss-Wissen</a>
    </p>
  </section>
</Base>
