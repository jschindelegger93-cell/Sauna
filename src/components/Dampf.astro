---
/** Unterschwelliger Dampf: steigt auf, sobald die Sektion sichtbar wird. Rein dekorativ. */
interface Props { links?: string; breite?: string }
const { links = '55%', breite = '40%' } = Astro.props;
---
<div class="dampf" aria-hidden="true" style={`--links:${links};--breite:${breite}`}>
  {Array.from({ length: 7 }, (_, i) => <span style={`--i:${i}`}></span>)}
</div>
<style>
  .dampf { position: absolute; left: var(--links); bottom: 0; width: var(--breite); height: 85%; z-index: 0; pointer-events: none; }
  .dampf span {
    position: absolute; bottom: -10%; left: calc(var(--i) * 13%); width: 38%; aspect-ratio: 1;
    border-radius: 50%; background: radial-gradient(circle, rgb(255 255 255 / 28%) 0%, rgb(255 255 255 / 0%) 70%);
    filter: blur(18px); opacity: 0; mix-blend-mode: screen;
  }
  :global(.an) .dampf span { animation: steigen calc(9s + var(--i) * 1.3s) ease-out calc(var(--i) * 1.1s) infinite; }
  @keyframes steigen {
    0% { opacity: 0; transform: translate3d(0, 0, 0) scale(0.6); }
    18% { opacity: 0.9; }
    60% { opacity: 0.45; }
    100% { opacity: 0; transform: translate3d(calc((var(--i) - 3) * 18px), -95%, 0) scale(1.9); }
  }
  @media (prefers-reduced-motion: reduce) { :global(.an) .dampf span { animation: none; } }
</style>
