---
/** Unterschwelliger Dampf: steigt auf, sobald die Sektion sichtbar wird. Rein dekorativ. */
interface Props { links?: string; breite?: string }
const { links = '55%', breite = '40%' } = Astro.props;
---
<div class="dampf" aria-hidden="true" style={`--links:${links};--breite:${breite}`}>
  {Array.from({ length: 11 }, (_, i) => <span style={`--i:${i}`}></span>)}
</div>
<style>
  .dampf { position: absolute; left: var(--links); bottom: 0; width: var(--breite); height: 85%; z-index: 0; pointer-events: none; }
  .dampf span {
    position: absolute; bottom: -10%; left: calc(var(--i) * 8.5%); width: 46%; aspect-ratio: 1;
    border-radius: 50%; background: radial-gradient(circle, rgb(255 255 255 / 48%) 0%, rgb(255 255 255 / 0%) 70%);
    filter: blur(22px); opacity: 0; mix-blend-mode: screen;
  }
  :global(.an) .dampf span { animation: steigen calc(7s + var(--i) * 0.8s) ease-out calc(var(--i) * 0.55s) infinite; }
  @keyframes steigen {
    0% { opacity: 0; transform: translate3d(0, 0, 0) scale(0.6); }
    15% { opacity: 1; }
    55% { opacity: 0.6; }
    100% { opacity: 0; transform: translate3d(calc((var(--i) - 5) * 22px), -105%, 0) scale(2.3); }
  }
  @media (prefers-reduced-motion: reduce) { :global(.an) .dampf span { animation: none; } }
</style>
