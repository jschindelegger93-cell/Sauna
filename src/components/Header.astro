---
import Logo from './Logo.astro';
import { S } from '../lib/site';
interface Props { ueberFoto?: boolean }
const { ueberFoto = false } = Astro.props;
const pfad = Astro.url.pathname;
const nav = [
  { href: '/saunaaufguss/', label: 'Saunaaufguss' },
  { href: '/sauna-zubehoer/', label: 'Zubehör' },
  { href: '/ratgeber/', label: 'Aufguss-Wissen' },
  { href: '/duft-finder/', label: 'Duft-Finder' },
  { href: '/ueber-uns/', label: 'Über uns' },
];
const a = S.announcement;
---
{a.aktiv && (
  <div class="ansage" role="region" aria-label="Hinweise">
    <a href={a.link} class="ansage-in">
      {a.botschaften.map((b, i) => <span class:list={['msg', { an: i === 0 }]}>{b}</span>)}
    </a>
  </div>
)}
<header class:list={['kopf', { transparent: ueberFoto }]} data-kopf>
  <div class="wrap kopf-in">
    <a href="/" class="marke" aria-label="ALMGLUT Startseite"><span class="logo-dunkel"><Logo klein /></span><span class="logo-hell"><Logo klein hell /></span></a>
    <nav aria-label="Hauptnavigation" id="nav" class="nav">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={pfad.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="nur-mobil"><button type="button" class="nav-beratung" data-beratung>Persönliche Duftberatung</button></li>
      </ul>
      <div class="nav-extra nur-mobil">
        <ul class="nav-klein">
          <li><a href="/aufguss-rechner/">Aufguss-Rechner</a></li>
          <li><a href="/faq/">Häufige Fragen</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
        <a href="/saunaaufguss/probierset/" class="nav-karte">
          <img src="/images/stock/aufguss-kelle-640.webp" alt="" width="640" height="427" loading="lazy" />
          <span><small>Zum Kennenlernen</small><strong>Probierset · 4 Düfte</strong><em>19,90 € →</em></span>
        </a>
        <p class="nav-herkunft">47° N · Aufguss aus den Alpen</p>
      </div>
    </nav>
    <button type="button" class="kopf-beratung" data-beratung>Beratung</button>
    <a href="/saunaaufguss/" class="btn btn--dunkel kopf-cta">Shop</a>
    <button class="menue" aria-controls="nav" aria-expanded="false" aria-label="Menü öffnen"><span></span><span></span></button>
  </div>
</header>

<dialog class="beratung" id="beratung" aria-labelledby="beratung-titel">
  <form method="dialog" class="schliessen-form"><button class="schliessen" aria-label="Schließen">×</button></form>
  <p class="augenbraue">Persönliche Duftberatung</p>
  <h2 id="beratung-titel">Welcher Aufguss passt zu dir?</h2>
  <p class="text">Schreib uns kurz, wie du saunierst. Wir empfehlen dir persönlich deinen Duft, meist innerhalb von 24 Stunden.</p>
  <form name="beratung" method="POST" data-netlify="true" netlify-honeypot="bot" action="/danke/" class="b-form">
    <input type="hidden" name="form-name" value="beratung" />
    <p class="visuell-versteckt"><label>Nicht ausfüllen <input name="bot" /></label></p>
    <div class="feld"><label for="b-name">Vorname</label><input id="b-name" name="name" autocomplete="given-name" required /></div>
    <div class="feld"><label for="b-mail">E-Mail</label><input id="b-mail" type="email" name="email" autocomplete="email" required /></div>
    <div class="feld">
      <label for="b-sauna">Deine Sauna</label>
      <select id="b-sauna" name="sauna"><option>Heimsauna (finnisch)</option><option>Biosauna</option><option>Fass- oder Gartensauna</option><option>Noch keine, suche ein Geschenk</option></select>
    </div>
    <div class="feld"><label for="b-frage">Was magst du? (optional)</label><textarea id="b-frage" name="frage" rows="3" placeholder="z. B. eher frisch oder holzig, für den Abend …"></textarea></div>
    <button type="submit" class="btn btn--glut btn--block">Beratung anfragen</button>
    <p class="mini">Kostenlos und unverbindlich. <a href="/datenschutz/">Datenschutz</a></p>
  </form>
</dialog>

<script>
  const kopf = document.querySelector<HTMLElement>('[data-kopf]');
  const btn = document.querySelector<HTMLButtonElement>('.menue');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const offen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!offen));
    btn.setAttribute('aria-label', offen ? 'Menü öffnen' : 'Menü schließen');
    nav?.classList.toggle('offen', !offen);
    kopf?.classList.toggle('menue-offen', !offen);
    document.body.style.overflow = offen ? '' : 'hidden';
  });
  const zu = () => { if (btn?.getAttribute('aria-expanded') === 'true') btn.click(); };
  addEventListener('keydown', (e) => { if (e.key === 'Escape') zu(); });
  nav?.querySelectorAll('a, [data-beratung]').forEach((el) => el.addEventListener('click', zu));
  if (kopf?.classList.contains('transparent')) {
    const pruefe = () => kopf.classList.toggle('fest', scrollY > 40);
    addEventListener('scroll', pruefe, { passive: true });
    pruefe();
  }
  const dlg = document.getElementById('beratung') as HTMLDialogElement | null;
  document.querySelectorAll('[data-beratung]').forEach((b) => b.addEventListener('click', () => dlg?.showModal()));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  const msgs = document.querySelectorAll('.ansage .msg');
  if (msgs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => { msgs[i].classList.remove('an'); i = (i + 1) % msgs.length; msgs[i].classList.add('an'); }, 4500);
  }
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('sichtbar'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.rein').forEach((el) => io.observe(el));
  // Animationen nur laufen lassen, solange die Sektion sichtbar ist
  const anim = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('an', e.isIntersecting)), { threshold: 0.25 });
  document.querySelectorAll('[data-anim]').forEach((el) => anim.observe(el));
</script>

<style>
  .ansage { background: var(--graphit); color: #f5f5f7; font-size: 0.8rem; position: relative; z-index: 1; height: 38px; overflow: hidden; }
  .ansage-in { display: grid; place-items: center; height: 38px; color: inherit; text-decoration: none; padding: 0 16px; text-align: center; }
  .msg { grid-area: 1 / 1; opacity: 0; transition: opacity 0.6s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: calc(100vw - 32px); }
  .msg.an { opacity: 1; }

  /* Hintergrund + Blur liegen auf ::before, damit das fixierte Menü nie vom Header beschnitten wird (iOS Safari) */
  .kopf { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgb(0 0 0 / 6%); transition: border-color 0.3s; }
  .kopf::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(255 255 255 / 82%); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); transition: opacity 0.3s; }
  .kopf.transparent { position: fixed; left: 0; right: 0; top: 38px; border-color: transparent; }
  .kopf.transparent::before { opacity: 0; }
  .kopf.transparent.fest, .kopf.transparent.menue-offen { top: 0; border-color: rgb(0 0 0 / 6%); }
  .kopf.transparent.fest::before { opacity: 1; }
  .kopf.menue-offen::before { opacity: 1; background: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .kopf-in { display: flex; align-items: center; gap: 28px; min-height: 80px; }
  .marke { text-decoration: none; margin-right: auto; display: grid; }
  .marke > span { grid-area: 1 / 1; transition: opacity 0.3s; }
  .logo-hell { opacity: 0; }
  .transparent:not(.fest):not(.menue-offen) .logo-hell { opacity: 1; }
  .transparent:not(.fest):not(.menue-offen) .logo-dunkel { opacity: 0; }
  .nav ul { list-style: none; display: flex; gap: 34px; margin: 0; padding: 0; }
  .nav a { text-decoration: none; font-size: 1.02rem; font-weight: 500; letter-spacing: -0.005em; color: var(--graphit); opacity: 0.85; }
  .nav a:hover, .nav a[aria-current] { opacity: 1; color: var(--graphit); }
  .nav a[aria-current] { font-weight: 600; }
  .transparent:not(.fest):not(.menue-offen) .nav a, .transparent:not(.fest):not(.menue-offen) .kopf-beratung { color: #fff; }
  .kopf-beratung { background: none; border: 0; font: 500 1.02rem var(--text); color: var(--graphit); cursor: pointer; padding: 8px 4px; }
  .kopf-beratung:hover { color: var(--glut-dunkel); }
  .kopf-cta { padding: 12px 24px; min-height: 46px; font-size: 1rem; }
  .transparent:not(.fest):not(.menue-offen) .kopf-cta { background: #fff; color: var(--graphit); }
  .nur-mobil { display: none !important; }
  .menue { display: none; background: none; border: 0; width: 44px; height: 44px; cursor: pointer; position: relative; color: var(--graphit); }
  .transparent:not(.fest):not(.menue-offen) .menue { color: #fff; }
  .menue span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: currentColor; transition: transform 0.25s, top 0.25s; }
  .menue span:first-child { top: 18px; }
  .menue span:last-child { top: 26px; }
  .menue[aria-expanded='true'] span:first-child { top: 22px; transform: rotate(45deg); }
  .menue[aria-expanded='true'] span:last-child { top: 22px; transform: rotate(-45deg); }
  @media (max-width: 1180px) {
    .menue { display: block; }
    .kopf-in { min-height: 70px; gap: 14px; }
    .kopf-cta { padding: 10px 18px; min-height: 42px; font-size: 0.95rem; }
    .nav { inset: 70px 0 auto 0 !important; height: calc(100vh - 70px); height: calc(100dvh - 70px); }
    .kopf-beratung { display: none; }
    .nur-mobil { display: block !important; }
    .nav-extra.nur-mobil { display: grid !important; }
    .nav { position: fixed; inset: 80px 0 0; background: #fff; padding: 8px var(--pad) calc(28px + env(safe-area-inset-bottom)); opacity: 0; pointer-events: none; transition: opacity 0.3s ease; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; }
    .nav.offen { opacity: 1; pointer-events: auto; }
    .nav ul { flex-direction: column; gap: 0; }
    .nav > ul > li, .nav-extra > * { opacity: 0; transform: translateY(14px); transition: opacity 0.45s ease, transform 0.45s cubic-bezier(.2,.7,.2,1); }
    .nav.offen > ul > li, .nav.offen .nav-extra > * { opacity: 1; transform: none; }
    .nav.offen > ul > li:nth-child(2) { transition-delay: 0.04s; } .nav.offen > ul > li:nth-child(3) { transition-delay: 0.08s; }
    .nav.offen > ul > li:nth-child(4) { transition-delay: 0.12s; } .nav.offen > ul > li:nth-child(5) { transition-delay: 0.16s; }
    .nav.offen > ul > li:nth-child(6) { transition-delay: 0.2s; } .nav.offen .nav-extra > * { transition-delay: 0.26s; }
    .nav > ul a, .nav-beratung { display: flex; justify-content: space-between; align-items: center; width: 100%; text-align: left; font: 600 1.55rem/1.2 var(--titel); letter-spacing: -0.02em; color: var(--graphit) !important; opacity: 1; padding: 13px 0; border: 0; border-bottom: 1px solid var(--linie); background: none; cursor: pointer; }
    .nav > ul a::after { content: '›'; font-weight: 400; color: #c7c7cc; font-size: 1.6rem; }
    .nav > ul a[aria-current] { color: var(--glut-dunkel) !important; }
    .nav-beratung { color: var(--glut-dunkel) !important; border-bottom: 0 !important; }
    .nav-extra { display: grid; gap: 20px; margin-top: auto; padding-top: 24px; }
    .nav-klein { display: flex !important; flex-direction: row !important; flex-wrap: wrap; gap: 8px !important; }
    .nav-klein a { display: inline-block; font: 500 0.92rem var(--text); color: var(--graphit); padding: 9px 14px; border-radius: 999px; background: var(--nebel); text-decoration: none; opacity: 1; }
    .nav-karte { display: grid; grid-template-columns: 112px 1fr; gap: 14px; align-items: center; background: var(--graphit); color: #fff; border-radius: var(--r-m); overflow: hidden; text-decoration: none; }
    .nav-karte img { width: 112px; height: 88px; object-fit: cover; }
    .nav-karte span { display: grid; gap: 2px; padding-right: 14px; }
    .nav-karte small { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #ffb36b; }
    .nav-karte strong { font: 600 1.05rem var(--titel); color: #fff; }
    .nav-karte em { font-style: normal; font-size: 0.9rem; color: #a1a1a6; }
    .nav-herkunft { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--grau); margin: 0; text-align: center; }
  }

  .beratung { border: 0; border-radius: var(--r); padding: 36px clamp(22px, 5vw, 40px); width: min(520px, calc(100% - 32px)); max-height: calc(100dvh - 32px); box-shadow: 0 30px 80px rgb(0 0 0 / 30%); color: var(--graphit); }
  .beratung::backdrop { background: rgb(0 0 0 / 45%); backdrop-filter: blur(6px); }
  .beratung h2 { font-size: clamp(1.7rem, 4vw, 2.2rem); }
  .beratung .text { color: var(--grau); }
  .schliessen-form { position: absolute; top: 14px; right: 14px; margin: 0; }
  .schliessen { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--nebel); font-size: 1.4rem; line-height: 1; cursor: pointer; color: var(--graphit); }
  .b-form { display: grid; gap: 14px; margin-top: 8px; }
  .mini { font-size: 0.78rem; color: var(--grau); text-align: center; margin: 0; }
</style>
