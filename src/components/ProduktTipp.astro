---
import { getEntry } from 'astro:content';
import { euro } from '../lib/site';
interface Props { slug?: string }
const p = Astro.props.slug ? await getEntry('produkte', Astro.props.slug) : undefined;
---
{p && (
  <aside class="tipp" style={`--akzent:${p.data.farbe}`} aria-label="Produktempfehlung">
    <img src={p.data.bild} alt="" width="160" height="160" loading="lazy" />
    <div>
      <p class="augenbraue">Passend zum Thema</p>
      <p class="name">{p.data.name}</p>
      <p class="txt">{p.data.kurz.split('. ')[0]}.</p>
      <a href={`/saunaaufguss/${p.id}/`} class="btn btn--dunkel">Ansehen · {euro(p.data.preis)}</a>
    </div>
  </aside>
)}
<style>
  .tipp { display: grid; grid-template-columns: 110px 1fr; gap: 20px; align-items: center; background: var(--weiss); border: 1px solid var(--linie); border-radius: var(--r); padding: 20px; margin: 40px 0; max-width: var(--lesebreite); }
  @media (min-width: 600px) { .tipp { grid-template-columns: 150px 1fr; } }
  img { border-radius: var(--r-s); }
  .augenbraue { margin-bottom: 6px; }
  .name { font: 500 1.3rem/1.2 var(--titel); color: var(--graphit); margin: 0 0 6px; }
  .txt { font-size: 0.93rem; color: var(--grau); }
  .btn { padding: 12px 20px; min-height: 44px; font-size: 0.92rem; }
</style>
