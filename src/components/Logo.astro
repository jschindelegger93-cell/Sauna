---
interface Props { hell?: boolean; klein?: boolean }
const { hell = false, klein = false } = Astro.props;
const farbe = hell ? '#F3EFE8' : '#1E3328';
---
<span class:list={['logo', { klein }]} aria-label="ALMGLUT">
  <svg viewBox="0 0 40 26" width={klein ? 30 : 38} height={klein ? 20 : 25} aria-hidden="true">
    <path d="M1 24 L13 9 L19 16 L27 4.5" fill="none" stroke={farbe} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M27 4.5 L39 24" fill="none" stroke={farbe} stroke-width="2" stroke-linecap="round" opacity=".5"/>
    <circle cx="27" cy="4.5" r="3.6" fill="#D9682B"/>
  </svg>
  <span class="wort" style={`color:${farbe}`}>ALMGLUT</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .wort { font: 600 1.06rem/1 var(--sans); letter-spacing: 0.32em; margin-right: -0.32em; }
  .klein .wort { font-size: 0.92rem; }
</style>
