---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Brotkrümelnavigation" class="bc wrap">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .bc { padding-top: 22px; font-size: 0.86rem; color: var(--stein); }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; }
  li:not(:last-child)::after { content: '/'; margin-left: 6px; color: var(--linie); }
  a { color: var(--stein); text-decoration: none; }
  a:hover { color: var(--tanne); text-decoration: underline; }
  span { color: var(--tanne); font-weight: 600; }
</style>
