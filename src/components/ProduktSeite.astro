---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import KaufBox from './KaufBox.astro';
import ProduktKarte from './ProduktKarte.astro';
import Faq from './Faq.astro';
import Foto from './Foto.astro';
import Dampf from './Dampf.astro';
import type { FotoKey } from '../lib/fotos';
import { S, SITE, abs, png, breadcrumbLd, faqLd, ORG_ID, produktUrl } from '../lib/site';

import type { CollectionEntry } from 'astro:content';
interface Props { p: CollectionEntry<'produkte'> }
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const alle = await getCollection('produkte');
const verwandt = d.verwandt.map((s) => alle.find((x) => x.id === s)).filter(Boolean) as typeof alle;
const artikel = (await getCollection('ratgeber')).filter((a) => d.ratgeber.includes(a.id));

const zub = d.typ === 'zubehoer';
const url = produktUrl(p);
const crumbs = [
  { name: 'Startseite', href: '/' },
  zub ? { name: 'Sauna-Zubehör', href: '/sauna-zubehoer/' } : { name: 'Saunaaufguss', href: '/saunaaufguss/' },
  { name: d.name, href: url },
];
const naechstesJahr = `${new Date().getFullYear() + 1}-12-31`;
const produktLd = {
  '@type': 'Product',
  '@id': abs(url) + '#produkt',
  name: `ALMGLUT ${d.name}`,
  description: d.kurz,
  image: [abs(png(d.bild))],
  sku: d.sku,
  ...(d.gtin ? { gtin13: d.gtin } : {}),
  brand: { '@type': 'Brand', name: 'ALMGLUT' },
  manufacturer: { '@id': ORG_ID },
  category: zub ? 'Sauna-Zubehör' : 'Saunaaufguss',
  ...(d.material ? { material: d.material } : {}),
  countryOfOrigin: 'AT',
  additionalProperty: [
    ...(d.duftnoten.length ? [{ '@type': 'PropertyValue', name: 'Duftnoten', value: d.duftnoten.join(', ') }] : []),
    { '@type': 'PropertyValue', name: zub ? 'Größe' : 'Inhalt', value: d.inhalt },
    ...(d.masse ? [{ '@type': 'PropertyValue', name: 'Maße', value: d.masse }] : []),
  ],
  offers: {
    '@type': 'Offer',
    url: abs(url),
    priceCurrency: 'EUR',
    price: d.preis.toFixed(2),
    priceValidUntil: naechstesJahr,
    itemCondition: 'https://schema.org/NewCondition',
    availability: d.verfuegbar ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    seller: { '@id': ORG_ID },
    shippingDetails: ['AT', 'DE'].map((land) => ({
      '@type': 'OfferShippingDetails',
      shippingRate: { '@type': 'MonetaryAmount', value: S.versandkosten.toFixed(2), currency: 'EUR' },
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: land },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 4, unitCode: 'DAY' },
      },
    })),
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: ['AT', 'DE'],
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 14,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/ReturnShippingFees',
    },
  },
};
const STIMMUNG_FOTO: Record<string, FotoKey> = {
  zirbe: 'huette-schnee-nacht', 'zirbe-reserve': 'sauna-dunkel-glas', latschenkiefer: 'nebelwald', heublume: 'alpental-sommer', bergminze: 'winter-bergsee',
  'almbox-geschenkset': 'sauna-paar', probierset: 'steine-nah', 'ritual-set': 'aufguss-frau',
  'aufgusskuebel-zirbe': 'aufguss-kelle', 'aufgusskelle-zirbe': 'aufguss-steine', 'leinen-saunatuch': 'sauna-waldblick', 'saunahut-loden': 'sauna-glut-mann', 'alpensalz-peeling': 'schneewald',
};
const stimmungFoto = STIMMUNG_FOTO[p.id] ?? 'saunasteine-dampf';
const titel = d.seo.title ?? `${d.name} – ${zub ? 'Sauna-Zubehör' : 'Saunaaufguss'}`;
const bildAlt = zub ? `ALMGLUT ${d.name}, ${d.inhalt}` : `ALMGLUT ${d.name}, Saunaaufguss ${d.inhalt}`;
const bandTitel = d.duftnoten.length ? `${d.duftnoten.join(', ')}.` : d.highlights.length ? d.highlights[0] + '.' : d.name;
const beschreibung = d.seo.description ?? d.kurz;
---
<Base title={titel} description={beschreibung} ogImage={d.seo.ogImage ?? png(d.bild)} ogType="product" noindex={d.seo.noindex} canonical={d.seo.canonical}
  schema={[produktLd, breadcrumbLd(crumbs), faqLd(d.faq)]}>
  <Breadcrumbs items={crumbs} />
  <section class="wrap produkt" style={`--akzent:${d.farbe}`}>
    <div class="galerie">
      <img src={d.bild} alt={bildAlt} width="800" height="800" fetchpriority="high" />
    </div>
    <div class="info">
      <p class="augenbraue">{d.limitiert ? 'Limitierte Edition · ' : ''}{d.nummer ? `${d.nummer} · ` : ''}{zub ? 'Sauna-Zubehör' : d.typ === 'set' ? 'Set' : 'Saunaaufguss'}</p>
      <h1>{d.typ === 'duft' ? `Saunaaufguss ${d.name.replace(/^No\. \d /, '')}` : d.name}</h1>
      <p class="kurz">{d.kurz}</p>
      <dl class="fakten">
        {d.duftnoten.length > 0 && <div><dt>Duftnoten</dt><dd>{d.duftnoten.join(', ')}</dd></div>}
        {d.material && <div><dt>Material</dt><dd>{d.material}</dd></div>}
        {d.masse && <div><dt>Maße</dt><dd>{d.masse}</dd></div>}
        {d.stimmung.length > 0 && <div><dt>Stimmung</dt><dd>{d.stimmung.join(', ')}</dd></div>}
        {d.anwendungen && <div><dt>Reicht für</dt><dd>ca. {d.anwendungen} Aufgüsse</dd></div>}
        {d.dosierung && <div><dt>Dosierung</dt><dd>{d.dosierung}</dd></div>}
      </dl>
      {d.highlights.length > 0 && <ul class="highlights">{d.highlights.map((h) => <li>{h}</li>)}</ul>}
      <KaufBox p={p} />
    </div>
  </section>

  <section class="stimmung foto" data-anim>
    <Foto k={stimmungFoto} />
    <Dampf links="45%" breite="50%" />
    <div class="wrap stimmung-in">
      <p class="augenbraue">{d.nummer ? `${d.nummer} · ` : ''}{d.duftnoten.length ? 'Duftbild' : 'Gemacht für die Sauna'}</p>
      <h2>{bandTitel}</h2>
      {d.stimmung.length > 0 && <p class="lead">{d.stimmung.map((x) => x[0].toUpperCase() + x.slice(1)).join(', ')}.</p>}
    </div>
  </section>

  <section class="sektion sektion--nebel">
    <div class="wrap inhalt">
      <article class="prosa">
        <h2>Über {d.name}</h2>
        <Content />
      </article>
      <aside class="details">
        <h2 class="h-klein">Produktdetails</h2>
        <dl>
          <dt>Inhalt</dt><dd>{d.inhalt}</dd>
          {d.herkunft && <><dt>Herkunft</dt><dd>{d.herkunft}</dd></>}
          {d.inhaltsstoffe && <><dt>Inhaltsstoffe</dt><dd>{d.inhaltsstoffe}</dd></>}
          {d.material && <><dt>Material</dt><dd>{d.material}</dd></>}
          {d.masse && <><dt>Maße</dt><dd>{d.masse}</dd></>}
          {d.sicherheit && <><dt>Sicherheitshinweise</dt><dd>{d.sicherheit}</dd></>}
          <dt>Artikelnummer</dt><dd>{d.sku}</dd>
        </dl>
        {!zub && <p class="hinweis">Saunaaufgüsse sind Duftkonzentrate und kein Arzneimittel. Bei Atemwegserkrankungen, in der Schwangerschaft oder bei Kreislaufproblemen vorher ärztlich abklären.</p>}
      </aside>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap schmal-faq">
      <Faq faq={d.faq} titel={`Fragen zu ${d.name}`} />
    </div>
  </section>

  {artikel.length > 0 && (
    <section class="sektion sektion--nebel">
      <div class="wrap">
        <p class="augenbraue">Aufguss-Wissen</p>
        <h2>Mehr zum Thema</h2>
        <ul class="raster raster--3 artikel">
          {artikel.map((a) => (
            <li class="karte"><a href={`/ratgeber/${a.id}/`}><strong>{a.data.titel}</strong><span>{a.data.lesezeit} Min. Lesezeit</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {verwandt.length > 0 && (
    <section class="sektion">
      <div class="wrap">
        <h2>Passt dazu</h2>
        <div class="raster raster--3">{verwandt.map((v) => <ProduktKarte p={v} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .produkt { display: grid; gap: clamp(24px, 4vw, 64px); padding-block: 24px clamp(48px, 7vw, 88px); }
  @media (min-width: 900px) { .produkt { grid-template-columns: 1.1fr 1fr; align-items: start; } .galerie { position: sticky; top: 110px; } }
  .galerie img { width: 100%; border-radius: var(--r); background: var(--weiss); }
  .stimmung { min-height: 70vh; display: flex; align-items: flex-end; }
  .stimmung-in { padding-block: 120px 80px; position: relative; z-index: 1; }
  .stimmung h2 { max-width: 18ch; }
  .galerie img { background: #f3f2ef; aspect-ratio: 1; object-fit: cover; }
  .kurz { font-size: 1.08rem; color: var(--graphit); }
  .fakten { margin: 18px 0 26px; display: grid; gap: 0; border-top: 1px solid var(--linie); }
  .fakten div { display: grid; grid-template-columns: 110px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--linie); font-size: 0.95rem; }
  dt { font-weight: 700; color: var(--graphit); }
  dd { margin: 0; }
  .inhalt { display: grid; gap: 48px; }
  @media (min-width: 960px) { .inhalt { grid-template-columns: 1fr 340px; } }
  .details { align-self: start; background: var(--nebel); border-radius: var(--r); padding: 26px; font-size: 0.92rem; }
  .h-klein { font: 700 0.78rem/1 var(--text); letter-spacing: 0.16em; text-transform: uppercase; color: var(--glut-dunkel); }
  .details dl { display: grid; gap: 4px 0; margin: 0; }
  .details dd { margin-bottom: 12px; }
  .hinweis { font-size: 0.82rem; color: var(--grau); margin: 8px 0 0; padding-top: 14px; border-top: 1px solid var(--linie); }
  .schmal-faq { max-width: 820px; }
  .highlights { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 8px; }
  .highlights li { position: relative; padding-left: 26px; font-size: 0.95rem; }
  .highlights li::before { content: ''; position: absolute; left: 2px; top: 0.45em; width: 12px; height: 8px; border-left: 2px solid var(--glut); border-bottom: 2px solid var(--glut); transform: rotate(-45deg); }
  .artikel { list-style: none; padding: 0; margin: 0; }
  .artikel a { display: grid; gap: 8px; padding: 22px; text-decoration: none; height: 100%; }
  .artikel strong { font: 500 1.15rem/1.3 var(--titel); color: var(--graphit); }
  .artikel span { font-size: 0.85rem; color: var(--grau); }
</style>
